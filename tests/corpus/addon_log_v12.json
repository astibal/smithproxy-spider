        "level": "warn",
        "msg": "hook message"
      }
    },
    "levels": [
      "error",
      "warn",
      "info",
      "alert",
      "debug"
    ],
    "python_levels": {
      "10": "debug",
      "20": "info",
      "21": "alert",
      "30": "warn",
      "40": "error"
    },
    "tiers": {
      "'alert'": 2,
      "'debug'": 3,
      "'error'": 0,
      "'info'": 2,
      "'unknown'": null,
      "'warn'": 1,
      "20": null
    }
  },
  "reference": "mitmproxy 12.3.1"
}
