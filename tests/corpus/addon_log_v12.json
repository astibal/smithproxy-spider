{
  "logging": {
    "add_log_hook": {
      "args_are_entry": true,
      "name": "add_log",
      "repr": "AddLogHook(entry=LogEntry(hook message, warn))"
    },
    "alert": 21,
    "colors": {
      "21": "magenta",
      "30": "yellow",
      "40": "red"
    },
    "entry": {
      "repr": "LogEntry(hook message, warn)",
